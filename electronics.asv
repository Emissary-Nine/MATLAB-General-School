clear; close all; clc; 

%% Electronics A/D D/A converter stuff

% v_in = 3.3;
v_max = 3.3;
v_min = 0;
% bits = 8;

% [bin, decimal] = voltage2bin(v_in,v_min,v_max,bits);

%% Sine wave input

offset = 1.65; % VDC
v_pkpk = 3.3; % Vpp
t = 0:0.0001:1; % Define time vector (0 to 1 second with 0.001 step)
f = 1; % Hz

v_in = offset + (v_pkpk/2)*sin(2 * f * pi * t);
bits = 12;

[bin2, decimal2] = voltage2bin(v_in,v_min,v_max,bits);

LocMax = max(decimal2);

% offset (DC) calcs

[binDC, decimalDC] = voltage2bin(offset,v_min,v_max,bits);

%% Minimum sampling frequency

f_max = 4000; % max frequency in Hz
f_smin = 2 * f_max % required sampling

f_s = 4000; % sampling 
f_nyq = f_s / 2 % nyquist frequency

f_alias = abs(f_max - f_s) % aliasing

%% Accelerometer

sens = 0.06; % sensitivity in V, v/g
V_M = 3.3; % Max V
V_m = 0; % Min V

% Want to find vibrations with resolution 0.1 g

ReqRes = sens * 0.1; % in V, required res

range = (V_M - V_m) / ReqRes; % required levels or bins

MaxIt = 1000; % max loop iteration

for i = 1:MaxIt

bitsAcc = 1 + i;

[binAcc, decimalAcc] = voltage2bin(1,V_m, V_M, bitsAcc);

while
    binAcc 
end

end